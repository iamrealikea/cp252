        }
      ]
    ]
  },
  "dependencies": {
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "jsdoc": "^4.0.5"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "jest-junit": "^17.0.0",
    "supertest": "^6.3.0"
  }
}
